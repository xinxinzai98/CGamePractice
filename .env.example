# Copy to .env only when overriding these defaults.
# Leave loopback binding in place when using a reverse proxy on the server.
DAWN_BIND_ADDRESS=127.0.0.1
DAWN_HTTP_PORT=8178

# Set to 1 only behind an HTTPS entrance; local HTTP testing uses 0.
DAWN_SECURE_COOKIES=0

# Comma-separated exact proxy IPs as seen by the container. Empty = trust none.
# The proxy must overwrite X-Forwarded-For; see docs/docker.md.
DAWN_TRUST_PROXY=
